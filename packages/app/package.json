{
  "name": "@blazers/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predev": "kill-port 3001",
    "dev": "next dev -p 3001",
    "prebuild": "rimraf .next",
    "build": "next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "@blazers/sdk": "workspace:*",
    "daisyui": "5.8.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "kill-port": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
